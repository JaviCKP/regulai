      "readback": "comma-separated category labels",
      "enforcement": "strict"
    },
    "chartFill": {
      "type": "color",
      "add": true,
      "set": true,
      "get": true,
      "description": "chart-level fill color (accepts #RRGGBB, named colors, or scheme names).",
      "readback": "#RRGGBB or color descriptor",
      "enforcement": "report"
