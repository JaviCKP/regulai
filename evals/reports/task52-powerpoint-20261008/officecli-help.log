      ]
    },
    "combotypes": {
      "type": "string",
      "aliases": [
        "combo.types"
      ],
      "add": true,
      "set": true,
      "get": false,
      "description": "rebuild as combo chart with per-series chart types (column,line,area,...). Comma-separated, one per series.",
      "examples": [
        "--prop combotypes=\u0022column,column,line\u0022"
      ]
