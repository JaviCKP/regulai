+    stdout.write(f'{len(rows)} pilot runs; real calls {actual_calls}; human review pending. Reports: {output}')
+    if stop:
+        raise CommandError('Pilot stopped: ' + stop + '. Retain the report and ledger; do not automatically retry.')
